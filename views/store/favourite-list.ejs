<%- include('../partials/head') %>
<body class="bg-gradient-to-br from-gray-50 via-white to-red-50 min-h-screen">
<%- include('../partials/nav') %>

<main class="container mx-auto px-4 sm:px-6 py-10 max-w-5xl">
    <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold text-gray-900 mb-3">My Favourites ❤️</h2>
        <p class="text-gray-500 text-lg">Your saved homes in one place</p>
    </div>

    <% if (favouriteHomes.length === 0) { %>
        <div class="bg-white rounded-[24px] sm:rounded-[32px] shadow-xl border border-gray-100 p-8 sm:p-12 text-center">
            <div class="text-7xl mb-5">❤️</div>
            <h3 class="text-2xl font-bold text-gray-800 mb-3">No Favourite Homes Yet</h3>
            <p class="text-gray-500 mb-8">Save your favourite homes and they will appear here.</p>
            <a href="/homes" class="inline-block bg-red-500 text-white px-8 py-4 rounded-2xl font-semibold shadow-lg hover:bg-red-600 hover:shadow-xl transition-all duration-300">
                Explore Homes
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% favouriteHomes.forEach(home => { %>
                <div class="bg-white rounded-[24px] sm:rounded-[32px] shadow-xl border border-gray-100 overflow-hidden hover:shadow-2xl transition-all duration-300">
                    <img src="<%= home.photos && home.photos.length > 0 ? home.photos[0] : home.photoUrl %>"
                         alt="<%= home.houseName %>" class="w-full h-48 object-cover">
                    <div class="p-6 flex justify-between items-center gap-4">
                        <div class="min-w-0">
                            <h3 class="text-xl font-bold text-gray-900 mb-1 truncate"><%= home.houseName %></h3>
                            <p class="text-gray-500 text-sm">📍 <%= home.location %></p>
                            <a href="/homes/<%= home._id %>" class="text-red-500 font-semibold hover:underline text-sm">View details &rarr;</a>
                        </div>
                        <form action="/favourite/delete/<%= home._id %>" method="POST" class="shrink-0">
                            <button type="submit" class="bg-red-500 text-white px-5 py-2.5 rounded-2xl font-semibold hover:bg-red-600 transition-all duration-300">
                                Remove
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</main>
</body>
</html>
