<%- include('../partials/head') %>
<body class="bg-gray-50">
<%- include('../partials/nav') %>

<!-- Hero -->
<section class="bg-gradient-to-br from-red-50 via-white to-gray-50 py-14 sm:py-20 px-4 sm:px-6">
    <div class="container mx-auto text-center">
        <h1 class="text-3xl sm:text-5xl font-bold text-gray-900 mb-4">Find your next stay</h1>
        <p class="text-gray-500 text-lg mb-8 max-w-xl mx-auto">
            Unique homes and experiences, all around the world.
        </p>

        <form action="/homes" method="GET" class="max-w-2xl mx-auto bg-white shadow-lg rounded-2xl p-3 flex flex-col sm:flex-row gap-3">
            <input type="text" name="location" placeholder="Where are you going?"
                class="flex-1 border border-gray-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-red-400">
            <button type="submit" class="bg-red-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-red-600 transition">
                Search 🔍
            </button>
        </form>
    </div>
</section>

<main class="container mx-auto px-4 sm:px-6 py-10">
    <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-800">Explore Amazing Homes</h2>
        <a href="/homes" class="text-red-500 font-semibold hover:underline whitespace-nowrap">View all &rarr;</a>
    </div>

    <% if (regesteredhome.length === 0) { %>
        <p class="text-center text-gray-400 py-16">No homes listed yet. Be the first to <a href="/host/add-home" class="text-red-500 underline">add one</a>!</p>
    <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-8">
        <% regesteredhome.forEach(home => { %>
            <div class="bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
                <div class="overflow-hidden">
                    <img src="<%= home.photos && home.photos.length > 0 ? home.photos[0] : home.photoUrl %>"
                        alt="<%= home.houseName %>"
                        class="w-full h-48 sm:h-56 object-cover hover:scale-105 transition duration-500">
                </div>
                <div class="p-5">
                    <h3 class="text-lg font-semibold text-gray-800 truncate"><%= home.houseName %></h3>
                    <p class="text-gray-500 text-sm mt-1">📍 <%= home.location %></p>
                    <div class="flex justify-between items-center mt-3">
                        <span class="text-red-500 font-bold text-lg">
                            ₹<%= home.price %> <span class="text-gray-500 text-sm font-normal">/ night</span>
                        </span>
                        <span class="font-medium text-gray-700">⭐ <%= home.rating %></span>
                    </div>
                    <div class="flex gap-3 mt-5">
                        <a href="/homes/<%= home._id %>" class="flex-1 text-center bg-gray-900 text-white py-2.5 rounded-xl hover:bg-black transition">Details</a>
                        <a href="/reserve/<%= home._id %>" class="flex-1 text-center bg-red-500 text-white py-2.5 rounded-xl hover:bg-red-600 transition">Book</a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
    <% } %>
</main>
</body>
</html>
