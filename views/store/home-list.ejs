<%- include('../partials/head') %>
<body class="bg-gray-50">
<%- include('../partials/nav') %>

<main class="container mx-auto px-4 sm:px-6 lg:p-8 py-8 lg:mt-2">

    <!-- Search & Filter Form -->
    <div class="bg-white shadow-lg rounded-2xl p-4 sm:p-6 mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-800 mb-4">🔍 Search Homes</h2>
        <form action="/homes" method="GET">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-sm">House Name</label>
                    <input type="text" name="title" placeholder="Search by title..." value="<%= filters.title %>"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">
                </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-sm">Location</label>
                    <input type="text" name="location" placeholder="Search by city..." value="<%= filters.location %>"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">
                </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-sm">Min Price</label>
                    <input type="number" name="minPrice" placeholder="Min ₹" min="0" value="<%= filters.minPrice %>"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">
                </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-sm">Max Price</label>
                    <input type="number" name="maxPrice" placeholder="Max ₹" min="0" value="<%= filters.maxPrice %>"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">
                </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-sm">Sort By</label>
                    <select name="sort" class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">
                        <option value="">Default</option>
                        <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>⭐ Top Rated</option>
                        <option value="priceLow" <%= filters.sort === 'priceLow' ? 'selected' : '' %>>💰 Price Low to High</option>
                        <option value="priceHigh" <%= filters.sort === 'priceHigh' ? 'selected' : '' %>>💰 Price High to Low</option>
                    </select>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 mt-4">
                <button type="submit" class="bg-red-500 text-white px-6 py-3 rounded-lg font-bold hover:bg-red-600 transition duration-300">
                    Search 🔍
                </button>
                <a href="/homes" class="text-center bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-bold hover:bg-gray-300 transition duration-300">
                    Clear ✖
                </a>
            </div>
        </form>
    </div>

    <p class="text-gray-500 mb-4">
        Found <span class="font-bold text-red-500"><%= regesteredhome.length %></span> homes
    </p>

    <% if (regesteredhome.length === 0) { %>
        <div class="text-center mt-16 mb-16">
            <p class="text-gray-400 text-6xl mb-4">🏠</p>
            <p class="text-gray-500 text-xl font-semibold">No homes found!</p>
            <p class="text-gray-400 mt-2">Try different search filters.</p>
            <a href="/homes" class="inline-block mt-6 bg-red-500 text-white px-6 py-3 rounded-lg font-bold hover:bg-red-600 transition duration-300">
                Clear Filters
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% regesteredhome.forEach(home => { %>
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col">
                    <img src="<%= home.photos && home.photos.length > 0 ? home.photos[0] : home.photoUrl %>"
                        alt="<%= home.houseName %>" class="w-full h-52 object-cover">
                    <div class="p-4 flex flex-col flex-1">
                        <h3 class="text-xl font-bold"><%= home.houseName %></h3>
                        <p class="text-gray-600">📍 <%= home.location %></p>

                        <div class="flex justify-between items-center mt-2">
                            <span class="text-red-500 font-bold">₹<%= home.price %> / night</span>
                            <span>⭐ <%= home.rating %></span>
                        </div>

                        <a href="/homes/<%= home._id %>"
                           class="inline-block text-center bg-gray-900 text-white px-4 py-2.5 rounded-xl mt-4 font-semibold hover:bg-black transition">
                            View Details
                        </a>

                        <div class="mt-3">
                            <%- include('../partials/favourite', {home: home}) %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

</main>
</body>
</html>
