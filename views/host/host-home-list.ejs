<%- include('../partials/head') %>
<body class="bg-gradient-to-br from-gray-50 via-white to-red-50 min-h-screen">
<%- include('../partials/nav') %>

<main class="container mx-auto px-4 sm:px-6 py-10 max-w-7xl">

    <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold text-gray-900 mb-3">Host Dashboard 🏠</h2>
        <p class="text-lg text-gray-500">Manage your listed homes and bookings</p>
    </div>

    <div class="bg-white rounded-[24px] sm:rounded-[32px] shadow-xl border border-gray-100 p-6 sm:p-8 mb-10">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="text-center md:text-left">
                <h3 class="text-2xl font-bold text-gray-900">Your Properties</h3>
                <p class="text-gray-500 mt-1">Total homes listed on platform</p>
            </div>
            <div class="bg-red-500 text-white px-8 py-4 rounded-2xl text-3xl font-bold">
                <%= regesteredhome.length %>
            </div>
        </div>
    </div>

    <% if (regesteredhome.length === 0) { %>
        <div class="bg-white rounded-[24px] sm:rounded-[32px] shadow-xl border border-gray-100 p-8 sm:p-12 text-center">
            <div class="text-7xl mb-5">🏠</div>
            <h3 class="text-2xl font-bold text-gray-800 mb-3">No Homes Added Yet</h3>
            <p class="text-gray-500 mb-8">Start hosting by adding your first property.</p>
            <a href="/host/add-home" class="inline-block bg-red-500 text-white px-8 py-4 rounded-2xl font-semibold shadow-lg hover:bg-red-600 hover:shadow-xl transition-all duration-300">
                Add Home
            </a>
        </div>
    <% } else { %>
        <div class="space-y-8">
            <% regesteredhome.forEach(home => { %>
                <div class="bg-white rounded-[24px] sm:rounded-[32px] shadow-xl border border-gray-100 overflow-hidden hover:shadow-2xl transition-all duration-300">

                    <div class="p-6 sm:p-8 border-b border-gray-100">
                        <div class="flex flex-col lg:flex-row justify-between lg:items-center gap-5">
                            <div>
                                <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2"><%= home.houseName %></h3>
                                <div class="inline-flex bg-blue-100 text-blue-700 px-4 py-2 rounded-full text-sm font-semibold">
                                    <%= home.bookings ? home.bookings.length : 0 %> Bookings
                                </div>
                            </div>

                            <div class="flex gap-3">
                                <a href="/host/edit-home/<%= home._id %>?editing=true"
                                    class="bg-green-500 text-white px-6 py-3 rounded-2xl font-semibold hover:bg-green-600 transition-all duration-300">
                                    Edit
                                </a>
                                <form action="/host/delete-home/<%= home._id %>" method="POST"
                                      onsubmit="return confirm('Delete this listing? This also removes its bookings, reviews and favourites.');">
                                    <button type="submit" class="bg-red-500 text-white px-6 py-3 rounded-2xl font-semibold hover:bg-red-600 transition-all duration-300">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="p-6 sm:p-8">
                        <% if (home.bookings && home.bookings.length > 0) { %>
                            <h4 class="text-xl font-bold text-gray-800 mb-6">Recent Bookings</h4>
                            <div class="space-y-4">
                                <% home.bookings.forEach(booking => { %>
                                    <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5">
                                        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4">
                                            <div>
                                                <p class="text-gray-400 text-sm">Guest</p>
                                                <p class="font-semibold text-gray-800">
                                                    👤 <%= booking.user ? booking.user.name : 'Unknown' %>
                                                </p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 text-sm">Stay Duration</p>
                                                <p class="font-semibold text-gray-800">🌙 <%= booking.totalNights %> Nights</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 text-sm">Dates</p>
                                                <p class="font-semibold text-gray-800">📅 <%= new Date(booking.checkIn).toLocaleDateString() %></p>
                                                <p class="font-semibold text-gray-800">📅 <%= new Date(booking.checkOut).toLocaleDateString() %></p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 text-sm">Revenue</p>
                                                <p class="font-bold text-green-600 text-lg">₹<%= booking.totalPrice %></p>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="bg-gray-50 rounded-2xl p-8 text-center">
                                <p class="text-gray-400 text-lg">No bookings yet.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

</main>
</body>
</html>
