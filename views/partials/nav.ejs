<nav class="bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100">
  <div class="container mx-auto px-4 sm:px-6 py-3">
    <div class="flex items-center justify-between">

      <!-- Logo -->
      <a href="/" class="text-red-500 font-bold text-xl sm:text-2xl shrink-0">
        🏠 Airbnb
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-6">
        <a href="/homes" class="<%= currentpage === 'Home' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1 transition">Homes</a>
        <a href="/favourite" class="<%= currentpage === 'favourite' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1 transition">Favourites</a>
        <a href="/bookings" class="<%= currentpage === 'bookings' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1 transition">Bookings</a>
        <a href="/host-home-list" class="<%= currentpage === 'host-homes' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1 transition">Host Homes</a>
        <a href="/host/add-home" class="<%= currentpage === 'addhome' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1 transition">Add Home</a>
      </div>

      <!-- Desktop auth area -->
      <div class="hidden md:flex items-center gap-3">
        <% if (locals.sessionUser) { %>
          <span class="font-medium text-gray-700 truncate max-w-[10rem]">👋 <%= sessionUser.name %></span>
          <form action="/logout" method="POST">
            <button class="bg-red-500 text-white px-4 py-2 rounded-xl hover:bg-red-600 transition">Logout</button>
          </form>
        <% } else { %>
          <a href="/login" class="px-4 py-2 rounded-xl border border-gray-300 hover:bg-gray-100 transition">Login</a>
          <a href="/signup" class="bg-red-500 text-white px-4 py-2 rounded-xl hover:bg-red-600 transition">Sign Up</a>
        <% } %>
      </div>

      <!-- Mobile hamburger -->
      <button id="navToggle" class="md:hidden p-2 rounded-lg hover:bg-gray-100" aria-label="Toggle menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="navMenu" class="hidden md:hidden mt-3 pb-2 space-y-1">
      <a href="/homes" class="block px-3 py-2 rounded-lg <%= currentpage === 'Home' ? 'bg-red-50 text-red-500 font-bold' : 'text-gray-600 hover:bg-gray-50' %>">Homes</a>
      <a href="/favourite" class="block px-3 py-2 rounded-lg <%= currentpage === 'favourite' ? 'bg-red-50 text-red-500 font-bold' : 'text-gray-600 hover:bg-gray-50' %>">Favourites</a>
      <a href="/bookings" class="block px-3 py-2 rounded-lg <%= currentpage === 'bookings' ? 'bg-red-50 text-red-500 font-bold' : 'text-gray-600 hover:bg-gray-50' %>">Bookings</a>
      <a href="/host-home-list" class="block px-3 py-2 rounded-lg <%= currentpage === 'host-homes' ? 'bg-red-50 text-red-500 font-bold' : 'text-gray-600 hover:bg-gray-50' %>">Host Homes</a>
      <a href="/host/add-home" class="block px-3 py-2 rounded-lg <%= currentpage === 'addhome' ? 'bg-red-50 text-red-500 font-bold' : 'text-gray-600 hover:bg-gray-50' %>">Add Home</a>

      <div class="pt-2 border-t border-gray-100 mt-2">
        <% if (locals.sessionUser) { %>
          <p class="px-3 py-2 font-medium text-gray-700">👋 <%= sessionUser.name %></p>
          <form action="/logout" method="POST" class="px-3">
            <button class="w-full bg-red-500 text-white px-4 py-2 rounded-xl hover:bg-red-600 transition">Logout</button>
          </form>
        <% } else { %>
          <div class="flex gap-3 px-3">
            <a href="/login" class="flex-1 text-center px-4 py-2 rounded-xl border border-gray-300 hover:bg-gray-100 transition">Login</a>
            <a href="/signup" class="flex-1 text-center bg-red-500 text-white px-4 py-2 rounded-xl hover:bg-red-600 transition">Sign Up</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  document.getElementById('navToggle').addEventListener('click', () => {
    document.getElementById('navMenu').classList.toggle('hidden');
  });
</script>
