# ---------- Server ----------
NODE_ENV=development
PORT=4000

# ---------- MongoDB ----------
# Connection string WITHOUT a database name (local or Atlas).
MONGODB_URL=mongodb://localhost:27017
DB_NAME=AIRBNB

# ---------- Auth ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Admin panel login (same as your ecommerce project) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ---------- Cloudinary (home photo uploads) ----------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# ---------- Razorpay (booking payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Email (forgot password). Gmail App Password, not your real password.
# If blank, the reset link is printed in the server console instead.
EMAIL_FROM=no-reply@example.com
EMAIL_USER=
EMAIL_PASSWORD=

# ---------- CORS / links ----------
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
